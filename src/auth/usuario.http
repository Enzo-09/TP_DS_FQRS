## Obtener todos los usuarios
GET  http://localhost:3000/api/usuarios

###

### Obtener usuario por ID
# @name getUserById
GET http://localhost:3000/api/usuarios/6

###

### Registro de nuevo usuario básico
# @name registerUseradmin123
POST http://localhost:3000/api/usuarios/register
Content-Type: application/json

{
  "email": "admin123@ejemplo.com",
  "telefono": "+1234567890",
  "password": "supersegura",
  "role": "ADMIN"
}


### Registro de nuevo usuario (metahumano)
# @name registerMetahumano
POST http://localhost:3000/api/usuarios/register
Content-Type: application/json

{
  "email": "peter.parker@ejemplo.com",
  "telefono": "+9876543210",
  "password": "spidersecret",
  "role": "METAHUMANO"
}

###

### Registro de nuevo usuario (burocrata)
# @name registerBurocrata
POST http://localhost:3000/api/usuarios/register
Content-Type: application/json

{
  "email": "burocrata@gobierno.com",
  "telefono": "+5555551234",
  "password": "supersegura",
  "role": "BUROCRATA"
}


### Login del usuario
# @name loginUser
POST http://localhost:3000/api/usuarios/login
Content-Type: application/json

{
  "email": "admin123@ejemplo.com",
  "password": "supersegura"
}


### Obtener usuario actual (requiere cookie con token)
GET http://localhost:3000/api/usuarios/me


### Logout del usuario (borra la cookie)
POST http://localhost:3000/api/usuarios/logout

###

##################################################
### ⚠️ ELIMINAR TODOS LOS USUARIOS (DESARROLLO)
##################################################

### ⚠️ PELIGRO: Eliminar TODOS los usuarios y perfiles
# Esto eliminará todos los usuarios, metahumanos y burócratas
# de la base de datos. Úsalo solo en desarrollo/testing.
# @name deleteAllUsers
DELETE http://localhost:3000/api/usuarios

###

##################################################
### 🔄 ACTUALIZAR ESTADO DE USUARIO
##################################################

### Activar usuario (cambiar estado a true)
# @name activateUser
PATCH http://localhost:3000/api/usuarios/1/estado
Content-Type: application/json

{
  "estado": true
}

###

### Desactivar usuario (cambiar estado a false)
# @name deactivateUser
PATCH http://localhost:3000/api/usuarios/1/estado
Content-Type: application/json

{
  "estado": false
}

###

