  "origen": "S.H.I.E.L.D."
}

###

##################################################
### 5️⃣ VALIDACIONES Y ERRORES
##################################################

### Intentar crear perfil para usuario inexistente (debe fallar)
# @name errorUsuarioInexistente
POST http://localhost:3000/api/burocratas
Content-Type: application/json

{
  "usuarioId": 999,
  "nombre": "Usuario Falso",
  "alias": "Fake Bureaucrat",
  "origen": "Nowhere"
}

###

### Intentar crear perfil sin campos obligatorios (debe fallar)
# @name errorCamposObligatorios
POST http://localhost:3000/api/burocratas
Content-Type: application/json

{
  "usuarioId": 1
}

###

### Intentar crear perfil para usuario que ya tiene perfil (debe fallar)
# @name errorPerfilDuplicado
POST http://localhost:3000/api/burocratas
Content-Type: application/json

{
  "usuarioId": 1,
  "nombre": "Duplicate Test",
  "alias": "Duplicate",
  "origen": "Test"
}

###

##################################################
### 6️⃣ ELIMINAR BURÓCRATAS
##################################################

### Eliminar burócrata (usar con cuidado)
# @name deleteBurocrata
DELETE http://localhost:3000/api/burocratas/1

###
